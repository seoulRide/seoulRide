# Copy this file to .env.local and fill in your keys.
# Never commit .env.local — it is gitignored.

# 서울 열린데이터광장 인증키 (필수)
# 발급: https://data.seoul.go.kr → 마이페이지 → 인증키 신청 (일반 인증키)
SEOUL_OPEN_API_KEY=

# 기상청 apihub 인증키 (권장 — 없으면 모의 날씨)
# 발급: https://apihub.kma.go.kr → 마이페이지 → API 키
KMA_API_KEY=

# NAVER Maps Client ID (지도 표시 필수)
# 콘솔 표기: "Client ID for NAVER Maps" (URL 파라미터로는 ncpKeyId)
# 발급: https://console.ncloud.com → AI·Application Service → Maps → Application 등록
# Web Service URL 등록 필수 (미등록 시 401):
#   http://localhost:3000
#   http://localhost:3030
#   https://<your-vercel-domain>.vercel.app
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# TMAP appKey (자전거 경로 안내 — 보행자 API를 자전거 경로 근사로 사용)
# 발급: https://openapi.sk.com → 회원가입 → 마이페이지 → 앱 등록 → appKey
# 미발급 시 직선 폴백으로 동작 (페이지는 정상)
TMAP_APP_KEY=
