# Copy this file to .env.local and fill in your keys.
# Never commit .env.local — it is gitignored.

# 서울 열린데이터광장 인증키 (필수)
# 발급: https://data.seoul.go.kr → 마이페이지 → 인증키 신청 (일반 인증키)
SEOUL_OPEN_API_KEY=

# 기상청 apihub 인증키 (권장 — 없으면 모의 날씨)
# 발급: https://apihub.kma.go.kr → 마이페이지 → API 키
KMA_API_KEY=

# NAVER Maps Client ID (지도 표시 필수)
# 콘솔 표기: "Client ID for NAVER Maps" (URL 파라미터로는 ncpKeyId)
# 발급: https://console.ncloud.com → AI·Application Service → Maps → Application 등록
# Web Service URL 등록 필수 (미등록 시 401):
#   http://localhost:3000
#   http://localhost:3030
#   https://<your-vercel-domain>.vercel.app
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Upstage Solar API key (트렌딩 핫플레이스 파이프라인 — Phase 2~3)
# 발급: https://console.upstage.ai → 가입 → API Keys
# 모델: solar-pro2 (구조화 JSON 출력 strict 지원). 호출은 OpenAI SDK 호환,
#   baseURL = https://api.upstage.ai/v1
# 미발급 시 트렌딩 파이프라인은 비활성, 홈은 sample/직전 trending.json으로 동작
SOLAR_API_KEY=

# Reddit script-app credentials (트렌딩 파이프라인 1차 소스)
# 발급: https://www.reddit.com/prefs/apps → Create app → "script" type
# 미발급 시 r/seoul · r/korea 미수집 (Visit Seoul + NAVER 뉴스만 사용)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=seoulRide/0.1 by /u/<your-reddit-handle>

# Supabase — ETL 결과물(인기 대여소 등)을 저장/조회하는 DB
# 발급: https://app.supabase.com → New project → Settings → API + Database
#   - SUPABASE_URL: Project URL (`https://xxxxxxxx.supabase.co`)
#   - SUPABASE_ANON_KEY: Web 앱 read용 (anon public key). RLS "Public read" 정책으로 제한됨
#   - SUPABASE_SERVICE_ROLE_KEY: 절대 클라이언트 노출 금지. GitHub Actions upsert 전용
# 미설정 시 웹앱은 _workspace JSON 폴백 (로컬 dev용)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
